NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=votre-cle-publishable
NEXT_PUBLIC_SITE_URL=https://adeio-baba-traores-projects.vercel.app
# En développement local, remplacer cette valeur dans .env.local par http://localhost:3000.

# Server-only elevated key: required for invitations, first-password completion, consented photo URLs and MFA synchronization.
SUPABASE_SECRET_KEY=sb_secret_...
# Clé AES-256-GCM dédiée aux jetons QR, 32 octets encodés en base64. Serveur uniquement.
ADEIO_QR_ENCRYPTION_KEY_V1=base64-a-generer-avec-openssl-rand-base64-32
# Garder toutes les versions utilisées ; incrémenter à chaque rotation de clé.
ADEIO_QR_ENCRYPTION_KEY_VERSION=1
# Secret Vercel Cron (32 octets minimum, aléatoire). Serveur uniquement.
CRON_SECRET=secret-aleatoire-a-configurer
# Legacy fallback for existing deployments; prefer SUPABASE_SECRET_KEY.
# SUPABASE_SERVICE_ROLE_KEY=votre-cle-service_role

# E-mail officiel affiché dans le footer et la page Contact (modifiable par variable).
CONTACT_EMAIL=adeioinde523@gmail.com
CONTACT_PHONE=
CONTACT_WHATSAPP=
